# ---- Contoh konfigurasi environment ----
# Salin ke `.env` lalu sesuaikan:  cp .env.example .env
# File `.env` TIDAK boleh di-commit (sudah ada di .gitignore).

# --- Database (dipakai service `db` + dibaca service `app`) ---
DB_NAME=mypuskeswan_db
DB_USER=mypuskeswan
DB_PASSWORD=ganti-password-kuat-disini
MYSQL_ROOT_PASSWORD=ganti-root-password-kuat-disini

# --- Aplikasi ---
# Port host -> container (ubah bila 8080 sudah dipakai)
APP_PORT=8080
# Kredensial admin awal (hanya dipakai saat user belum ada)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-admin-password-disini

# --- Opsional ---
# TZ=Asia/Jakarta
# SKIP_DB_INIT=0
# DB_WAIT_TIMEOUT=60
